# .env.test.example — every environment variable the backend reads in the
# hermetic test stack. Copy to `.env.test` (git-ignored):
#
#     cp .env.test.example .env.test
#
# CI does exactly this in .github/workflows/verify.yml before `make up-test`.
# Every value is a fixture — no real secrets, safe to commit as the template.
# NEVER put production credentials in .env.test.

# ---- Environment tag. Gates conditional-required vars in backend/config.py —
#      TURNSTILE_SECRET_KEY is required only when ENV=production. ----
ENV=test

# ---- Required at boot — config.RuntimeError otherwise. ----
MONGO_URL=mongodb://mongo:27017
DB_NAME=atlas_test
JWT_SECRET=test-jwt-secret-do-not-use-in-prod-4c9e2b7a8d1f0e6b

# ---- CORS (S-02): explicit list; NEVER "*". Includes backend origin so
#      Playwright / curl driving the backend directly on :18443 works. ----
CORS_ORIGINS=http://localhost:13000,https://localhost:18443

# ---- Admin seeder (S-20). ADMIN_EMAIL uses a `.test` suffix — a reserved
#      TLD (RFC 6761) that config.AuthSettings.admin_email (str, not EmailStr)
#      accepts. `.local` would break EmailStr consumers elsewhere. ----
ADMIN_EMAIL=admin-boot@test.local
ADMIN_PASSWORD=BootAdmin@2026-Test-Secret-91a4c8

# ---- Stripe (S-05 fallback closed by giving explicit values). stripe-mock
#      validates keys against `^Bearer sk_test_[a-zA-Z0-9]+$` — no underscores
#      or hyphens after the prefix. Real Stripe accepts anything; this
#      pattern is safe for tests-only. ----
STRIPE_SECRET_KEY=sk_test_atlasstripemockacceptsanykey
STRIPE_WEBHOOK_SECRET=whsec_test_atlas_locally_generated_for_signature_tests
# sitecustomize.py (test image only) reads STRIPE_API_BASE at interpreter
# startup and does `stripe.api_base = os.environ[...]` before server.py imports.
# The smoke test test_stripe_api_base_is_the_mock catches an unset value.
STRIPE_API_BASE=http://stripe-mock:12111

# ---- Turnstile (S-08 partial). Cloudflare-published test key: always-passes.
#      Non-empty on purpose so the _verify_turnstile fail-open WARN is not
#      exercised in the default test run. ----
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ---- Refund + drill signature secrets (S-04 fallback closed). ----
REFUND_AUDIT_SIGN_SECRET=test-refund-audit-signing-secret-b3c7e2f4a91d
DRILL_SIGN_SECRET=test-drill-signing-secret-e28f9b1c4d5a7f60

# ---- Public URLs (email + PDF link generation). ----
APP_BASE_URL=https://localhost:18443
PUBLIC_BASE_URL=https://localhost:18443
PUBLIC_SITE_URL=http://localhost:13000

# ---- Storage / integration proxy (S-15 + S-27 closed). Points at the
#      in-memory storage-mock service defined in docker-compose.test.yml.
#      backend/tests/_storage_mock/app.py accepts any storage_token value. ----
INTEGRATION_PROXY_URL=http://storage-mock:9000
STORAGE_TOKEN=test-storage-token-not-real

# ---- Mailer (silent no-op when RESEND_API_KEY is empty; see mailer.py). ----
SENDER_EMAIL=noreply@test.local

# ---- Business rule ladder (H-8 closed). This ONE value is intentionally set
#      to a non-default (4 vs code default 3) so test_config.py can prove
#      pydantic-settings is actually reading .env — a regression that stops
#      reading env would otherwise be invisible when every value matches the
#      default. §12 revision-ladder tests assert behaviour at 4, not 3. ----
REVISION_REVIEW_THRESHOLD=4
REVISION_PENALTY_THRESHOLD=5
REVISION_RECOVERY_UNDER_REVIEW=3
REVISION_RECOVERY_EXCESSIVE=5
REVISION_VISIBILITY_PENALTY=20
REVISION_RATE_NUDGE_PENALTY=10
REVISION_DISPUTE_FEE_USD=49
REFUND_ALERT_THRESHOLD_PCT=20
EMPLOYER_FLAG_UNIQUE_TALENTS=3
EMPLOYER_FLAG_WINDOW_DAYS=60
PROVEN_RELIABLE_DAYS=90

# ---- Optional external services (documented silent-fail). ----
# EMERGENT_LLM_KEY: fully optional post-F-01. When unset AND the
# emergentintegrations package isn't installed, ai_service._HAS_LLM = False
# and suggest_hourly_rate returns the rule-based fallback. Kept as a
# non-empty fixture here for parity with the old harness values.
EMERGENT_LLM_KEY=test-emergent-key-not-real
RESEND_API_KEY=
SLACK_WEBHOOK_URL=

# ---- Frontend (compose passes this into the CRA dev server). ----
REACT_APP_BACKEND_URL=https://localhost:18443

# ---- Sub-process coverage collection (test image only). See
#      backend/tests/sitecustomize.py. Setting this causes every Python
#      process in the container to auto-start a coverage tracer. Data files
#      accumulate under /tmp/coverage/ and are combined by
#      `make coverage-gaps`. ----
COVERAGE_PROCESS_START=/app/backend/.coveragerc

# .env.example — every variable backend/config.py or frontend/src/config.js reads.
#
# Copy this to `.env` (dev) or `.env.test` (test harness) or `.env.production`
# and fill in real values. All three are gitignored — real secrets NEVER get
# committed.
#
# REQUIRED variables have no default in config.py; boot fails with ONE
# consolidated error listing every missing var. OPTIONAL variables are marked
# with either "safe default" (a sensible fallback) or "silent no-op if unset"
# (feature is intentionally disabled when the key is missing — see the
# CLAUDE.md landmine list).
#
# The authoritative catalogue is backend/config.py (nested BaseSettings
# groups) and docs/CONFIG_INVENTORY.md (per-var provenance). This file is
# the human-friendly copy meant for filling in.

# =============================================================================
# ENVIRONMENT TAG — REQUIRED
# =============================================================================
# Gates behaviour that must differ between environments:
#   development   permissive; captcha fail-opens with a WARN log
#   test          same as development, active harness code paths
#   production    strict: TURNSTILE_SECRET_KEY becomes required-at-boot
# Missing ENV fails boot loudly. There is intentionally NO default — deploying
# to prod without setting this would silently pick "development" and neuter
# the S-08 production Turnstile enforcement, which is the highest-consequence
# config bug the module can prevent.
ENV=development

# =============================================================================
# MONGO — REQUIRED (both)
# =============================================================================
MONGO_URL=mongodb://localhost:27017
DB_NAME=atlas

# =============================================================================
# AUTH / JWT / ADMIN SEEDER
# =============================================================================
# REQUIRED — signs the httpOnly access_token cookie. Rotating it invalidates
# every existing session (there is no revocation list; see S-07).
JWT_SECRET=

# OPTIONAL — email used by the admin seeder + admin display name.
# Currently defaults to `admin@talenthub.io` (S-20 legacy brand-drift; not
# yet the branded geminista.com value).
ADMIN_EMAIL=admin@talenthub.io

# OPTIONAL — no default (S-20 removed the old "Admin@2026" fallback). If
# unset, the admin seeder logs a WARN and skips seeding, so no hardcoded
# credential is ever inserted.
ADMIN_PASSWORD=

# OPTIONAL in dev/test, REQUIRED when ENV=production (S-08 partial).
# Cloudflare Turnstile server secret. When unset in dev/test, the captcha
# check fail-opens with a WARN log naming the remote IP so the bypass is
# never silent. Source: https://dash.cloudflare.com (Turnstile widget)
TURNSTILE_SECRET_KEY=

# =============================================================================
# STRIPE — REQUIRED (both). S-05 removed the "sk_test_emergent" fallback.
# =============================================================================
# Source: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=

# Source: https://dashboard.stripe.com/webhooks — click your endpoint, copy
# the "Signing secret" (starts with whsec_).
STRIPE_WEBHOOK_SECRET=

# =============================================================================
# STORAGE — REQUIRED (both).
# S-27: no more silent fallback to integrations.emergentagent.com.
# S-15: STORAGE_TOKEN is its own env var, no longer borrows EMERGENT_LLM_KEY.
# =============================================================================
# Base URL of the object-storage proxy. Anything routed here handles avatars,
# portfolio, dispute evidence, and government ID from KYB — must be a service
# you actually trust.
INTEGRATION_PROXY_URL=

# Auth token for the storage service. Rotates independently from LLM keys.
STORAGE_TOKEN=

# =============================================================================
# CRYPTO / SIGNING — REQUIRED (both). S-04 partial: hardcoded fallbacks
# ("jobatlas-refund-v1" / "jobatlas-drill-v1") removed. HMAC upgrade + verify-
# endpoint recompute still open.
# =============================================================================
REFUND_AUDIT_SIGN_SECRET=
DRILL_SIGN_SECRET=

# =============================================================================
# CORS — REQUIRED. S-02 partial: "*" default removed; wildcard rejected as
# a value. Comma-separated allowlist of exact origins the SPA loads from.
# Full S-02 (per-env origin validation) still open.
# =============================================================================
CORS_ORIGINS=http://localhost:3000

# =============================================================================
# PUBLIC URLs — used to build outbound links (verification email, PDF QR).
# =============================================================================
# Base URL of the API + email verification landing.
APP_BASE_URL=
# Public URL for QR-code deep links in signed PDFs.
PUBLIC_BASE_URL=
# Public SPA origin — used by /sitemap.xml + email CTAs when the request
# has no X-Forwarded-* headers to derive from.
PUBLIC_SITE_URL=

# =============================================================================
# MAIL (Resend) — OPTIONAL. Silent no-op when RESEND_API_KEY is unset
# (intentional per CLAUDE.md landmine list).
# =============================================================================
# Source: https://resend.com/api-keys
RESEND_API_KEY=

# From-address. Defaults to Resend's shared sandbox address.
SENDER_EMAIL=onboarding@resend.dev

# =============================================================================
# SLACK / TEAMS — OPTIONAL. Silent no-op when unset.
# =============================================================================
# Incoming webhook URL (Slack app or Teams webhook — both accept the same
# {"text": ...} payload shape).
SLACK_WEBHOOK_URL=

# =============================================================================
# LLM — OPTIONAL. When unset, ai_service falls back to rule-based rates
# (intentional silent-fail per CLAUDE.md landmine list).
# =============================================================================
EMERGENT_LLM_KEY=

# =============================================================================
# BUSINESS-RULE LADDER — all OPTIONAL. Defaults match FEATURES.md §12 verbatim.
# Set explicitly only when overriding for a specific deployment.
# =============================================================================
REVISION_REVIEW_THRESHOLD=3
REVISION_PENALTY_THRESHOLD=5
REVISION_DISPUTE_FEE_USD=49
REVISION_VISIBILITY_PENALTY=20
REVISION_RATE_NUDGE_PENALTY=10
EMPLOYER_FLAG_UNIQUE_TALENTS=3
EMPLOYER_FLAG_WINDOW_DAYS=60
REVISION_RECOVERY_UNDER_REVIEW=3
REVISION_RECOVERY_EXCESSIVE=5
PROVEN_RELIABLE_DAYS=90
REFUND_ALERT_THRESHOLD_PCT=20

# F-10 CLOSED: was hardcoded literal in deps.py:153; now env-tunable.
RATE_DRIFT_THRESHOLD_PCT=15

# =============================================================================
# FRONTEND — REACT_APP_* vars picked up at CRA/craco build time.
# =============================================================================
# REQUIRED (F-08 CLOSED). If unset, the SPA renders a red configuration-error
# banner into #root and refuses to mount — no more silent "undefined/api"
# requests + blank page. See frontend/src/config.js.
REACT_APP_BACKEND_URL=http://localhost:8000

# OPTIONAL — defaults to Cloudflare's public always-passes test key so local
# dev without a Turnstile account keeps working. Source:
# https://dash.cloudflare.com (Turnstile widget)
REACT_APP_TURNSTILE_SITE_KEY=

# .env.dev.example — template for the hand-driven local dev stack.
#
# Copy to .env.dev and fill in your own values.  Never commit .env.dev
# (it is git-ignored by .gitignore's `.env.*` rule — only this .example
# file is unignored).
#
#     cp .env.dev.example .env.dev
#     $EDITOR .env.dev
#
# See docs/LOCAL_SETUP.md for step-by-step instructions on where each
# value comes from (Stripe dashboard, Resend dashboard, etc.).
#
# NEVER put production credentials here.  Stripe stays in test mode
# (sk_test_… keys only).  A single `sk_live_…` value would let the dev
# stack charge real cards through the UI.

# ---- Environment tag ------------------------------------------------------
# One of: development / test / production.  In `development`, Turnstile is
# optional (backend/config.py:_enforce_production_required) so you can leave
# TURNSTILE_SECRET_KEY unset and still boot.
ENV=development

# ---- MongoDB --------------------------------------------------------------
# Two options:
#   (a) Container Mongo bundled in docker-compose.dev.yml — leave this
#       exactly as below.  Data lives in the `atlas-dev-mongo` named volume
#       and survives `make down-dev`.  Nuke with `make down-dev-hard`.
#   (b) MongoDB Atlas free tier — replace with your SRV connection string:
#       MONGO_URL=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# DB_NAME is arbitrary — pick something distinct from `atlas_test` so a
# stray backend-test run can't touch your hand-driven state.
MONGO_URL=mongodb://mongo:27017
DB_NAME=atlas_dev

# ---- JWT signing ---------------------------------------------------------
# Generate a fresh 256-bit secret:
#     openssl rand -hex 32
# If you rotate this while dev containers are running every user gets
# logged out — that is the whole point.
JWT_SECRET=REPLACE_WITH_openssl_rand_hex_32

# ---- CORS -----------------------------------------------------------------
# S-02: no wildcards, allow_credentials=True.  Include both origins so
# curl / Postman driving the backend directly on :8443 works too.
CORS_ORIGINS=http://localhost:3000,https://localhost:8443

# ---- Admin seeder ---------------------------------------------------------
# server.py's admin seeder inserts a superadmin on boot IFF both are set.
# S-20: ADMIN_PASSWORD has no default — the seeder skips-with-WARN when
# unset.  For dev, set both so you have a hand-drivable admin login.
ADMIN_EMAIL=admin@dev.local
ADMIN_PASSWORD=REPLACE_WITH_a_strong_password_you_will_actually_use

# ---- Stripe (TEST MODE ONLY) ---------------------------------------------
# From https://dashboard.stripe.com/test/apikeys — copy the "Secret key"
# starting with `sk_test_`.  Never a `sk_live_` value.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME_from_stripe_test_dashboard
# STRIPE_WEBHOOK_SECRET is the value `stripe listen` prints when it starts.
# See docs/LOCAL_SETUP.md §"Stripe":
#     stripe login
#     stripe listen --forward-to https://localhost:8443/api/stripe/webhook --skip-verify
# The line "Your webhook signing secret is whsec_…" — paste that here.
# Rotates every time you start `stripe listen`, so expect to update this
# roughly once per dev session.
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME_from_stripe_listen_output
# STRIPE_API_BASE is deliberately unset — sitecustomize.py checks env and
# no-ops when unset, so the SDK talks to real Stripe.  Setting this would
# silently redirect to a mock.  Leave commented out unless you know why.
# STRIPE_API_BASE=

# ---- Cloudflare Turnstile ------------------------------------------------
# Two paths:
#   (a) Cloudflare's published always-pass test key (recommended for dev):
#       TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
#       And in this file's REACT_APP_TURNSTILE_SITE_KEY (below):
#       REACT_APP_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   (b) A real Turnstile site (from https://dash.cloudflare.com → Turnstile):
#       Create a site with hostname `localhost`, copy the site + secret
#       keys, paste each into the correct var.
# S-08: in ENV=development this can be unset (fails-open with a WARN log).
# Prefer setting it explicitly to the test key so the code path is exercised.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ---- Refund + drill signature secrets (S-04) -----------------------------
# Independent HMAC keys, one per receipt kind.  Generate each with:
#     openssl rand -hex 32
# Don't share the same value across both — that was the vulnerability.
REFUND_AUDIT_SIGN_SECRET=REPLACE_WITH_openssl_rand_hex_32
DRILL_SIGN_SECRET=REPLACE_WITH_a_DIFFERENT_openssl_rand_hex_32

# ---- Public URLs ----------------------------------------------------------
# Used to build outbound links in emails and PDFs.  Match the dev port map.
APP_BASE_URL=https://localhost:8443
PUBLIC_BASE_URL=https://localhost:8443
PUBLIC_SITE_URL=http://localhost:3000

# ---- Storage --------------------------------------------------------------
# No real cloud-storage provider is wired to backend/storage_client.py yet
# (it speaks a proprietary API shape, not S3/R2/GCS/Supabase — tracked in
# the backlog).  Dev uses the local `storage-mock` container.  Uploads
# never leave your laptop — perfect for hand-driving; do NOT reuse this
# setup for anything shared.
INTEGRATION_PROXY_URL=http://storage-mock:9000
STORAGE_TOKEN=dev-any-string-storage-mock-accepts-anything

# ---- Mailer (Resend) ------------------------------------------------------
# From https://resend.com/api-keys — copy a key starting with `re_`.  If
# you leave RESEND_API_KEY empty, mailer.py falls through to a silent
# no-op (logged as `[mailer:noop]`) — verification emails never send.
# SENDER_EMAIL MUST be a verified sender on your Resend account
# (https://resend.com/domains).  Resend rejects unverified senders with
# 403 and the whole registration flow breaks.  Easiest path: verify a
# personal domain, use `noreply@<your-domain>`.
RESEND_API_KEY=
SENDER_EMAIL=onboarding@resend.dev

# ---- Slack (optional) ----------------------------------------------------
# Ops notifications.  Silent-fail intentional — leave blank in dev unless
# you have a private test channel you don't mind pinging.
SLACK_WEBHOOK_URL=

# ---- LLM (optional) ------------------------------------------------------
# ai_service.suggest_hourly_rate falls back to rule-based rates on ANY
# exception, so leaving this at a placeholder value is safe — the fallback
# fires and rates still come out sensible.  Only replace if you want to
# exercise the LLM-suggested-rate path end-to-end.
EMERGENT_LLM_KEY=dev-placeholder-llm-falls-back-to-rules

# ---- Business rule ladder ------------------------------------------------
# All optional in dev — pydantic-settings uses the defaults from
# backend/config.py:BusinessRules if any is omitted.  Un-comment and
# override only if you're exercising a specific §12 revision-ladder or
# §14 refund-threshold scenario.
# REVISION_REVIEW_THRESHOLD=3
# REVISION_PENALTY_THRESHOLD=5
# REVISION_DISPUTE_FEE_USD=49
# REFUND_ALERT_THRESHOLD_PCT=20

# ---- Frontend (compose forwards these into the CRA dev server) ----------
# REACT_APP_BACKEND_URL is set in docker-compose.dev.yml directly (must
# match the host-published backend port) — do NOT set it here or the
# compose value will be overridden.
#
# REACT_APP_TURNSTILE_SITE_KEY is optional here; compose falls back to
# Cloudflare's test site key.  Set only if you configured a real
# Turnstile site above.
# REACT_APP_TURNSTILE_SITE_KEY=1x00000000000000000000AA
